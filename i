$d = [Convert]::FromBase64String(($blob -replace '\s', ''))
function Get-Part([byte[]]$a, [int]$o, [int]$n) { $r = New-Object byte[] $n; [Array]::Copy($a, $o, $r, 0, $n); , $r }
$salt = Get-Part $d 0 16; $iv = Get-Part $d 16 16; $mac = Get-Part $d 32 32; $ct = Get-Part $d 64 ($d.Length - 64)
$code = $null
for ($try = 1; $try -le 3 -and -not $code; $try++) {
    $sec = Read-Host ' Enter PIN' -AsSecureString
    $p = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($sec)
    try { $pin = [Runtime.InteropServices.Marshal]::PtrToStringBSTR($p) } finally { [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($p) }
    Write-Host ' Checking PIN...' -ForegroundColor DarkGray
    $k = (New-Object Security.Cryptography.Rfc2898DeriveBytes -ArgumentList $pin, $salt, 100000).GetBytes(64)
    $ms = New-Object IO.MemoryStream; $ms.Write($iv, 0, 16); $ms.Write($ct, 0, $ct.Length)
    $calc = (New-Object Security.Cryptography.HMACSHA256 -ArgumentList (, (Get-Part $k 32 32))).ComputeHash($ms.ToArray())
    $diff = 0; for ($i = 0; $i -lt 32; $i++) { $diff = $diff -bor ($calc[$i] -bxor $mac[$i]) }
    if ($diff -ne 0) { Write-Host ' Wrong PIN.' -ForegroundColor Red; continue }
    $aes = [Security.Cryptography.Aes]::Create(); $aes.Mode = 'CBC'; $aes.Padding = 'PKCS7'
    $aes.Key = (Get-Part $k 0 32); $aes.IV = $iv
    $packed = $aes.CreateDecryptor().TransformFinalBlock($ct, 0, $ct.Length)
    $gz = New-Object IO.Compression.GZipStream((New-Object IO.MemoryStream(, $packed)), [IO.Compression.CompressionMode]::Decompress)
    $code = (New-Object IO.StreamReader($gz, [Text.Encoding]::UTF8)).ReadToEnd()
}
if ($code) { & ([scriptblock]::Create($code)) } else { Write-Host ' Too many wrong tries.' -ForegroundColor Red }
